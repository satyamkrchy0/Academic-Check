generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PredictionRecord {
  id                    String   @id @default(cuid())
  userMongoId           String
  academicScore         Float
  skillsRating          Float
  projectsCount         Int
  internshipExperience  Int
  communicationSkills   Float
  employmentProbability Float
  careerReadinessScore  Float
  explanation           String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}
